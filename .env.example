# ==========================================
# Next.js App Environment Variables
# ==========================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Safe for client browsers)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (Used for server-side administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Render API Key (for service automation)
RENDER_API_KEY=your_render_api_key_here

# ==========================================
# Supabase Edge Function (WhatsApp Bot) Variables
# (Configure these in Supabase Dashboard -> Functions -> Secrets)
# ==========================================
# SUPA_URL=https://your-project-id.supabase.co
# SUPA_SERVICE_KEY=your_service_role_key
# GEMINI_API_KEY=your_google_gemini_api_key
# EVOLUTION_API_URL=https://your-evolution-api.onrender.com
# EVOLUTION_API_KEY=your_evolution_api_key
# EVOLUTION_INSTANCE=main-instance
